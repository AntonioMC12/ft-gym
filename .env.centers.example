# Copy to .env.centers, separate from .env. The API's existing env_file loads .env in full:
# never put bootstrap/migrator passwords there. Compose reads .env.centers for interpolation only.
# This example contains no credentials.
# Generate three DIFFERENT passwords. Bootstrap/migrator never belong in the API runtime.
CENTERS_DB_NAME=ft_gym_centers
CENTERS_BOOTSTRAP_PASSWORD=
CENTERS_MIGRATOR_PASSWORD=
CENTERS_APP_PASSWORD=
CENTERS_ENVIRONMENT=development

# Direct Node development (outside Compose), optional URL instead of the separate fields:
# CENTERS_ENABLED=1
# CENTERS_DATABASE_URL=postgresql://centers_app:URL_ENCODED_PASSWORD@HOST:5432/ft_gym_centers
# CENTERS_MIGRATION_DATABASE_URL=postgresql://centers_migrator:URL_ENCODED_PASSWORD@HOST:5432/ft_gym_centers

# Isolated integration tests: NEVER reuse the above database. Must use *_centers_test or *_centers_test_*.
# CENTERS_TEST_DATABASE_URL=postgresql://centers_app:URL_ENCODED_PASSWORD@HOST:5432/ft_gym_centers_test
# CENTERS_TEST_MIGRATION_DATABASE_URL=postgresql://centers_migrator:URL_ENCODED_PASSWORD@HOST:5432/ft_gym_centers_test
